# ==============================================================================
# ANSAB PORTFOLIO — ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (Vercel), add these variables in your Vercel Project Settings > Environment Variables.
# NEVER commit .env or .env.local to GitHub!
# ==============================================================================

# Supabase Project Configuration
# Found in: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - Never expose in VITE_ variables!)
# Used by Vercel Serverless Functions (/api/*) to perform privileged operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Admin Authentication & Security
# Used to sign session tokens securely
ADMIN_JWT_SECRET=super-secret-jwt-signing-key-change-this-in-production

# Initial Admin Credentials (defaults)
# The username is ANSAB; temporary dev password is 2006
INITIAL_ADMIN_USERNAME=ANSAB
INITIAL_ADMIN_PASSWORD=2006

# Optional: Email Service for Contact Form Notifications (Resend / SendGrid / SMTP)
# RESEND_API_KEY=re_123456789
# NOTIFICATION_EMAIL=ansabthalappil@gmail.com
